<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline frame-timing harness (no Unity): from the repo root, sh tools/timing/check.sh (or dotnet run -c Release in this folder)
       Exits 1 when a simulation's response depends on the frame rate beyond the tolerance (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\SfMorph\SimClock.cs" />
  </ItemGroup>
</Project>
