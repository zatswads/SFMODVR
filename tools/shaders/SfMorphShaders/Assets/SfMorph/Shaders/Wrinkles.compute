// SfMorph skin wrinkles (0.9.0): how much her skin is compressed across the authored creases of each wrinkle region.
//   RegionClear  : zero the per-region sums of a sheet (once per frame, before its renderers).
//   RegionStrain : per region triangle (only triangles under an authored region are uploaded), the live edges of the skinned buffer
//                  against the neutral (rest) triangle -> 2x2 right Cauchy-Green tensor C in the (t, b) rest basis -> the stretch
//                  along the region's compression direction d (unit, in (t, b): across the crease lines there): sqrt(d^T C d);
//                  compression = max(0, 1 - stretch). Adds weight x compression and weight (fixed point) to the region's sums.
// The CPU reads the sums back (AsyncGPUReadback, a few frames late), takes num / den per region and fades the region's authored
// creases in with attack / release. Strain is invariant to rigid motion of the skinned buffer (no skinning-space calibration).
// Directional, so a frown (skin pushed together sideways) doesn't raise the forehead's horizontal lines, and only the inside of a
// bent elbow (compressed along the arm) wrinkles, not the stretched outside.
#pragma kernel RegionClear
#pragma kernel RegionStrain

ByteAddressBuffer _Verts;               // skinned output (vertexBufferTarget |= Raw): _Stride bytes per vertex, position at _PosOff
uint _Stride, _PosOff, _TriCount, _SumCount;
float _InvScale2;                       // 1 / (median live/rest distance ratio)^2: cancels a uniform scale of the skinned buffer

StructuredBuffer<uint> _Tris;           // 3 vertex ids per region triangle
StructuredBuffer<float4> _RegTri;       // 2 per region triangle: [DmInv m00 m01 m10 m11], [d.t, d.b, weight (fixed-point units), region]
RWStructuredBuffer<uint> _Sums;         // 2 per region: sum(weight x compression), sum(weight)

[numthreads(64, 1, 1)]
void RegionClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _SumCount) _Sums[id.x] = 0;
}

float3 LoadPos(uint v)
{
    return asfloat(_Verts.Load3(v * _Stride + _PosOff));
}

[numthreads(64, 1, 1)]
void RegionStrain(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _TriCount) return;
    float4 m = _RegTri[2 * i];
    float4 r = _RegTri[2 * i + 1];
    if (r.z < 0.5) return;
    float3 p0 = LoadPos(_Tris[3 * i]);
    float3 p1 = LoadPos(_Tris[3 * i + 1]);
    float3 p2 = LoadPos(_Tris[3 * i + 2]);
    float3 e1 = p1 - p0, e2 = p2 - p0;
    // F = Ds * DmInv (3x2): column j = sum_k edge_k * DmInv[k][j]
    float3 f0 = e1 * m.x + e2 * m.z;
    float3 f1 = e1 * m.y + e2 * m.w;
    float c00 = dot(f0, f0) * _InvScale2, c01 = dot(f0, f1) * _InvScale2, c11 = dot(f1, f1) * _InvScale2;
    float lam = c00 * r.x * r.x + 2.0 * c01 * r.x * r.y + c11 * r.y * r.y;   // squared stretch along d
    float comp = saturate(1.0 - sqrt(max(lam, 0.0)));
    if (!(comp == comp)) comp = 0.0;                                           // NaN (a collapsed live triangle)
    uint reg = (uint)(r.w + 0.5);
    uint o;
    InterlockedAdd(_Sums[2 * reg], (uint)(r.z * comp + 0.5), o);
    InterlockedAdd(_Sums[2 * reg + 1], (uint)(r.z + 0.5), o);
}
